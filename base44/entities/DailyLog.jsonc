{
  "name": "DailyLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "flow_intensity": {
      "type": "string",
      "enum": [
        "none",
        "light",
        "medium",
        "heavy"
      ],
      "default": "none",
      "title": "Flow"
    },
    "mood": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "okay",
        "low",
        "anxious"
      ],
      "title": "Mood"
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cramps",
          "ovulation_cramps",
          "headache",
          "bloating",
          "fatigue",
          "breast_tenderness",
          "spotting",
          "acne",
          "cravings",
          "appetite_loss",
          "backache",
          "mood_swings",
          "insomnia",
          "dreams",
          "increased_libido",
          "cervical_mucus"
        ]
      },
      "default": [],
      "title": "Symptoms"
    },
    "discharge": {
      "type": "boolean",
      "default": false,
      "title": "Discharge"
    },
    "discharge_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "egg_white",
          "creamy",
          "watery",
          "sticky",
          "milky_white",
          "discoloured",
          "yellow",
          "green",
          "brown"
        ]
      },
      "default": [],
      "title": "Discharge type"
    },
    "had_sex": {
      "type": "boolean",
      "default": false,
      "title": "Had sex today"
    },
    "alcohol": {
      "type": "boolean",
      "default": false,
      "title": "Alcohol"
    },
    "light_exercise": {
      "type": "boolean",
      "default": false,
      "title": "Light exercise"
    },
    "intense_exercise": {
      "type": "boolean",
      "default": false,
      "title": "Intense exercise"
    },
    "caffeine": {
      "type": "boolean",
      "default": false,
      "title": "Caffeine"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "maxLength": 1000
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}