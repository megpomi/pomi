{
  "name": "DailyLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "flow_intensity": {
      "type": "string",
      "enum": [
        "none",
        "light",
        "medium",
        "heavy"
      ],
      "default": "none",
      "title": "Flow"
    },
    "mood": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "okay",
        "low",
        "anxious"
      ],
      "title": "Mood"
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cramps",
          "ovulation_cramps",
          "headache",
          "bloating",
          "fatigue",
          "breast_tenderness",
          "acne",
          "cravings",
          "appetite_loss",
          "backache",
          "mood_swings",
          "insomnia",
          "dreams",
          "increased_libido",
          "cervical_mucus",
          "spotting"
        ]
      },
      "default": [],
      "title": "Symptoms"
    },
    "had_sex": {
      "type": "boolean",
      "default": false,
      "title": "Had sex today"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "maxLength": 1000
    }
  },
  "required": [
    "date"
  ]
}