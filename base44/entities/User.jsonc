{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "Subscription plan; written by the payments webhook.",
      "enum": [
        "free",
        "adfree_monthly",
        "adfree_yearly"
      ],
      "default": "free"
    }
  },
  "required": [
    "role"
  ]
}